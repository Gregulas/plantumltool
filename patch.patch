 const MAX_HISTORY = 200;
 const MERGE_WINDOW_MS = 700;
 
+function resetDiagramZoomOnReload() {
+  // Zoom is intentionally session-only. Remove any previously persisted zoom
+  // value before the application restores UI state.
+  for (let index = localStorage.length - 1; index >= 0; index -= 1) {
+    const key = localStorage.key(index);
+    if (key && /(?:^|[-_.:])(?:preview-)?zoom(?:$|[-_.:])/i.test(key)) {
+      localStorage.removeItem(key);
+    }
+  }
+
+  const applyActualSize = () => {
+    const controls = [...document.querySelectorAll('button, [role="button"]')];
+    const actualSizeButton = controls.find((control) => {
+      const description = [
+        control.textContent,
+        control.title,
+        control.getAttribute('aria-label'),
+        control.dataset?.action,
+      ].filter(Boolean).join(' ').trim();
+
+      return /(?:^|\s)100%(?:\s|$)|actual size|reset zoom/i.test(description);
+    });
+
+    if (actualSizeButton && !actualSizeButton.disabled) {
+      actualSizeButton.click();
+    }
+  };
+
+  applyActualSize();
+  requestAnimationFrame(applyActualSize);
+  window.addEventListener('load', applyActualSize, { once: true });
+}
